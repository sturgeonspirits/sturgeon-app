# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── QR Token Signing (generate with: openssl rand -hex 32)
QR_HMAC_SECRET=YOUR_32_BYTE_HEX_SECRET

# ─── Daily check-in HMAC (generate with: openssl rand -hex 32)
CHECKIN_SECRET=YOUR_32_BYTE_HEX_SECRET

# ─── Web Push VAPID (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:hello@sturgeonspiritsdistillery.com

# ─── App URL (used in auth redirects and invite emails)
# Must match the deployed domain exactly — no trailing slash
NEXT_PUBLIC_APP_URL=https://club.sturgeonspirits.com
NEXT_PUBLIC_SITE_URL=https://club.sturgeonspirits.com

# ─── Internal API secrets (generate each with: openssl rand -hex 32)
SYNC_SECRET=YOUR_SYNC_SECRET
CRON_SECRET=YOUR_CRON_SECRET

# ─── Development only
NODE_ENV=development
