# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── QR Token Signing (generate with: openssl rand -hex 32)
QR_HMAC_SECRET=YOUR_32_BYTE_HEX_SECRET

# ─── Web Push VAPID (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:hello@sturgeonspiritsdistillery.com

# ─── App
NEXT_PUBLIC_APP_URL=https://app.sturgeonspiritsdistillery.com
NODE_ENV=development
